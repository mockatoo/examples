{
	"name": "@mockatoo/example-better-auth-sveltekit",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port ${PORT:-3000}",
		"build": "vite build",
		"start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
		"preview": "vite preview --port ${PORT:-3000} --strictPort",
		"lint": "biome check .",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "playwright test",
		"ci": "pnpm lint && pnpm typecheck && pnpm test"
	},
	"dependencies": {
		"@mockatoo/connect-better-auth": "^0.3.0",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/kit": "^3.2.0",
		"better-auth": "1.7.25",
		"svelte": "^5.57.3",
		"vite": "^8.3.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@playwright/test": "^1.56.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.0.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@10.15.0"
}
