{
	"name": "@mockatoo/example-better-auth-sveltekit",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port ${PORT:-3000}",
		"build": "vite build",
		"start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
		"preview": "vite preview --port ${PORT:-3000} --strictPort",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "playwright test"
	},
	"dependencies": {
		"@mockatoo/connect-better-auth": "^0.1.2",
		"@sveltejs/adapter-vercel": "^5.8.0",
		"@sveltejs/kit": "^2.48.5",
		"better-auth": "1.7.7",
		"svelte": "^5.38.0",
		"vite": "^7.1.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.56.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^24.0.0",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2"
	}
}
