language js(typescript,jsx)

or {
  `$object.MOCKATOO_URL`,
  `const $binding = $value` where { $binding <: r".*MOCKATOO_URL.*" },
  `let $binding = $value` where { $binding <: r".*MOCKATOO_URL.*" },
  `var $binding = $value` where { $binding <: r".*MOCKATOO_URL.*" },
  $literal where {
    $literal <: string(),
    $literal <: r".*https://app\.mockatoo\.globalunderdog\.com.*"
  }
} as $violation where {
  register_diagnostic(
    span = $violation,
    message = "Users are not expected to know the Mockatoo URL or configure it. Import MOCKATOO_URL from your @mockatoo connector instead; only the manual OIDC example supplies its own URL.",
    severity = "error"
  )
}
