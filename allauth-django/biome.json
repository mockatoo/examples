{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*.{js,jsx,ts,tsx,json,jsonc,vue,svelte}",
			"!!**/node_modules",
			"!!**/.venv",
			"!!**/.next",
			"!!**/.nuxt",
			"!!**/.output",
			"!!**/.next-dev",
			"!!**/.svelte-kit",
			"!!**/.vercel",
			"!!**/dist",
			"!!**/build",
			"!!**/.turbo",
			"!!**/out",
			"!!**/coverage",
			"!!**/test-results",
			"!!**/playwright-report",
			"!!**/.pack",
			"!!**/upstream-copy",
			"!!**/generated.ts",
			"!!**/generated"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"root": true,
	"plugins": ["./lint/no-mockatoo-url.grit"],
	"overrides": [
		{
			"includes": ["**/*.vue", "**/*.svelte"],
			"formatter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			},
			"linter": {
				"rules": {
					"preset": "none",
					"correctness": {
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
